# ===== 凭据（绝不入仓）=====
.ds_user_token
*.env
superapi.env
*credentials*
*token*
!.gitignore

# ===== 白名单：仓库自带的运维脚本（名字里带 token 也不许被误吞）=====
!tools/*.sh
!tools/*.py
!tests/*.py
!docs/*.md
!deploy/launchd/*.plist

# ===== 二进制与发行包（走 Release，不入仓）=====
*.tar.gz
*.tgz
*.zip
unpacked/
dist-server/
dist/
*.exe
*.so
*.dylib
superapi
superapi-linux-*
superapi-*.app/

# ===== 会话/临时产物 =====
config.json
accounts.json
sessions/
context_*.txt
*.log
*.lock
*.pid

# ===== 系统噪音 =====
.DS_Store
._*
__MACOSX/
__pycache__/
*.pyc
.venv/
venv/
